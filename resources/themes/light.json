{
  "version": 1,
  "id": "light",
  "name": "浅色",
  "primitive": {
    "gray-50": "#f8f9fb",
    "gray-100": "#f1f3f7",
    "gray-200": "#e5e8ef",
    "gray-300": "#d3d8e2",
    "gray-500": "#5b6472",
    "gray-700": "#2a2f39",
    "gray-900": "#0f1115",
    "blue-500": "#2563eb",
    "blue-600": "#1d4ed8",
    "blue-400": "#3b82f6",
    "red-500": "#dc2626",
    "red-400": "#ef4444",
    "white": "#ffffff"
  },
  "semantic": {
    "bg.window": "gray-100",
    "bg.surface": "white",
    "bg.elevated": "gray-50",
    "bg.input": "white",
    "bg.hover": "gray-200",
    "text.primary": "gray-900",
    "text.secondary": "gray-700",
    "text.placeholder": "gray-500",
    "text.onAccent": "white",
    "border.default": "gray-300",
    "border.focus": "blue-500",
    "accent": "blue-500",
    "accent.hover": "blue-600",
    "accent.soft": "blue-400",
    "danger": "red-500",
    "danger.hover": "red-400",
    "selection.bg": "blue-500",
    "scrollbar.handle": "gray-300",
    "scrollbar.hover": "gray-500"
  },
  "component": {
    "chat.userBubble.bg": "accent",
    "chat.userBubble.text": "text.onAccent",
    "chat.assistantBubble.bg": "bg.elevated",
    "chat.assistantBubble.text": "text.primary",
    "avatar.user.bg": "accent",
    "avatar.user.text": "text.onAccent",
    "avatar.assistant.bg": "bg.surface",
    "avatar.assistant.text": "text.primary",
    "avatar.border": "border.default",
    "input.bg": "bg.input",
    "input.border": "border.default",
    "toolbar.bg": "bg.surface"
  }
}
