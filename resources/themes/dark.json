{
  "version": 1,
  "id": "dark",
  "name": "深色",
  "primitive": {
    "gray-950": "#16181d",
    "gray-900": "#1e2126",
    "gray-850": "#22262e",
    "gray-800": "#252932",
    "gray-700": "#333844",
    "gray-600": "#4a5060",
    "gray-500": "#6b7280",
    "gray-300": "#a8b0bd",
    "gray-100": "#e6e9ef",
    "blue-500": "#3b82f6",
    "blue-600": "#2563eb",
    "blue-400": "#60a5fa",
    "red-500": "#ef4444",
    "red-400": "#f87171",
    "white": "#ffffff"
  },
  "semantic": {
    "bg.window": "gray-950",
    "bg.surface": "gray-900",
    "bg.elevated": "gray-800",
    "bg.input": "gray-850",
    "bg.hover": "gray-700",
    "text.primary": "gray-100",
    "text.secondary": "gray-300",
    "text.placeholder": "gray-500",
    "text.onAccent": "white",
    "border.default": "gray-700",
    "border.focus": "blue-500",
    "accent": "blue-500",
    "accent.hover": "blue-600",
    "accent.soft": "blue-400",
    "danger": "red-500",
    "danger.hover": "red-400",
    "selection.bg": "blue-600",
    "scrollbar.handle": "gray-700",
    "scrollbar.hover": "gray-600"
  },
  "component": {
    "chat.userBubble.bg": "accent",
    "chat.userBubble.text": "text.onAccent",
    "chat.assistantBubble.bg": "bg.elevated",
    "chat.assistantBubble.text": "text.primary",
    "avatar.user.bg": "accent",
    "avatar.user.text": "text.onAccent",
    "avatar.assistant.bg": "bg.elevated",
    "avatar.assistant.text": "text.primary",
    "avatar.border": "border.default",
    "input.bg": "bg.input",
    "input.border": "border.default",
    "toolbar.bg": "bg.surface"
  }
}
